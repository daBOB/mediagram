  {
    "name": "the catalog's runtime is believed whenever there is one",
    "fn": "trustedRuntime",
    "args": [
      {
        "catalogued": 2400,
        "observed": 30,
        "direct": true
      }
    ],
    "expect": 2400
  },
  {
    "name": "the catalog's runtime is believed even off the direct path",
    "fn": "trustedRuntime",
    "args": [
      {
        "catalogued": 2400,
        "observed": 30,
        "direct": false
      }
    ],
    "expect": 2400
  },
  {
    "name": "the browser's runtime is believed only on the direct path",
    "fn": "trustedRuntime",
    "args": [
      {
        "catalogued": null,
        "observed": 1800,
        "direct": true
      }
    ],
    "expect": 1800
  },
  {
    "name": "a conversion's still-growing runtime is never believed",
    "fn": "trustedRuntime",
    "args": [
      {
        "catalogued": null,
        "observed": 1260,
        "direct": false
      }
    ],
    "expect": 0
  },
  {
    "name": "nothing known anywhere is zero, not a guess",
    "fn": "trustedRuntime",
    "args": [
      {
        "catalogued": null,
        "observed": null,
        "direct": true
      }
    ],
    "expect": 0
  },
  {
    "name": "a catalogued zero is not believed either",
    "fn": "trustedRuntime",
    "args": [
      {
        "catalogued": 0,
        "observed": 0,
        "direct": true
      }
    ],
    "expect": 0
  },
  {
    "name": "absent fields are the same as unknown ones",
    "fn": "trustedRuntime",
    "args": [
      {
        "direct": false
      }
    ],
    "expect": 0
