<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.picture-in-picture"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- android.permission.ACCESS_NETWORK_STATE merges in from
         :core:playback's own manifest (SystemUnmeteredNetworkCheck). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- PreloadService's own type — a manual film preload surviving the
         viewer leaving the app. See PreloadService and the POST_NOTIFICATIONS
         note below: this one is not exempt the way PlaybackService's is, and
         is declared anyway, deliberately without that permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Enforced only on API 37+ (Android 17) devices; without it there,
         TCP to the home cache server's LAN address times out and NSD
         finds nothing. Declaring it is harmless on older OS versions —
         there is no such platform permission for checkSelfPermission to
         deny — and LanCacheViewModel's own gate never asks for it below
         37 in the first place. See LanCacheBlock's permission prompt. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Not a runtime permission — declared only. Held for the duration of
         one discovery pass (LanServerLocator.discover()), never continuously. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- No android.permission.POST_NOTIFICATIONS. Two services post a
         notification and neither needs it: PlaybackService's is a
         MediaSession one (see the "Media sessions" row of
         https://developer.android.com/develop/ui/views/notifications/notification-permission#exemptions),
         exempt on API 33+ entirely. PreloadService's is a plain one and is
         deliberately left unrequested: the service still runs and still
         preloads without it — a foreground service needs a `Notification`
         object to start with, not the permission to actually show it — the
         notification is simply never shown, and the film page's own
         progress bar is where a viewer actually watches it. Request this
         only if a future notification genuinely needs to reach someone who
         is not looking at the app. -->

    <!-- Only apps signed with this app's key hold it: Spieltisch, which reads the game night
         through GameNightProvider. Spieltisch declares it too, so it holds it whichever app
         is installed first. -->
    <permission
        android:name="com.mediagram.android.permission.GAME_NIGHT"
        android:protectionLevel="signature" />

    <!-- Android 11+ hides other apps unless asked for; the Games row launches Spieltisch. -->
    <queries>
        <package android:name="com.mediagram.spieltisch" />
    </queries>

    <!-- largeHeap: media3's buffer alone reaches ~144 MB on a film above ~23 Mbit/s, which
         with the app ran past the 192 MB default heap and crashed the warm-up of a
         30 Mbit/s film; the large heap (512 MB on the TVs) leaves it room. -->
    <application
        android:name=".MediagramApp"
        android:largeHeap="true"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Mediagram">

        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Mediagram">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game night, the titles and their images for Spieltisch; read-only. -->
        <provider
            android:name="games.GameNightProvider"
            android:authorities="com.mediagram.android.games"
            android:exported="true"
            android:permission="com.mediagram.android.permission.GAME_NIGHT" />
    </application>

</manifest>
