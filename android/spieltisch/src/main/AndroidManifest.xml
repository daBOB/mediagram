<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A television app: the box hosts the night and the phones join it. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- The host serves the phones and the TV page; the page talks to it over loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Enforced only on API 37+; without it the phones on the Wi-Fi can neither reach the host
         nor find its NSD announcement there. Harmless to declare on older versions. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- No CHANGE_WIFI_MULTICAST_STATE: the system's mDNS responder sends the NSD announcement; the
         media app holds that permission only for its own discovery of the LAN cache server. -->

    <!-- The media app's game night: its profile's kids lock, its films and their images. Declared here
         as well as there, so Spieltisch holds it whichever app is installed first; only apps signed
         with the same key can. -->
    <permission
        android:name="com.mediagram.android.permission.GAME_NIGHT"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.mediagram.android.permission.GAME_NIGHT" />

    <!-- Android 11+ hides other apps' providers unless asked for. -->
    <queries>
        <provider android:authorities="com.mediagram.android.games" />
    </queries>

    <application
        android:name=".SpieltischApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_launcher"
        android:label="Spieltisch"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Recreating the activity would end the night (it stops when the screen stops), so a keyboard
             or gamepad connecting, or a locale, theme or display change, is handled in place instead. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|screenSize|smallestScreenSize|screenLayout|orientation|density|fontScale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
