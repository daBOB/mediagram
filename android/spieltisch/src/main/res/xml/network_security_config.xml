<?xml version="1.0" encoding="utf-8"?>
<!--
    The TV page is the box talking to its own game host over plain http on
    127.0.0.1. Nothing else this app loads is cleartext, so only loopback is
    allowed it.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
