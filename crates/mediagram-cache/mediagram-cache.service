# Install to /etc/systemd/system/mediagram-cache.service, then:
#   sudo systemctl enable --now mediagram-cache
# See docs/running-the-player.md, "Home cache server", for the full setup
# and how to read the pairing token this creates on first run.
[Unit]
Description=mediagram-cache: a LAN chunk store for the Android app
After=network-online.target

[Service]
# No user to create ahead of time: systemd allocates one for the lifetime
# of the service and owns CacheDirectory/StateDirectory for it.
DynamicUser=yes
# /var/cache/mediagram-cache — the chunks; $CACHE_DIRECTORY.
CacheDirectory=mediagram-cache
# /var/lib/mediagram-cache — the pairing token, separate from the chunks so
# clearing the cache does not unpair every device; $STATE_DIRECTORY.
StateDirectory=mediagram-cache
ExecStart=/usr/local/bin/mediagram_cache
Restart=on-failure

# No Telegram session, no secrets beyond the token in StateDirectory; this
# process needs nothing else on the box.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
